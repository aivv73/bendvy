def pending_returned(~S:Data,~components:L.Layout,~resources:L.Layout,~E:Data,~route:L.Route,~Ops:Data -> (Type -> Type) -> Type -> Type -> Type,~User:Type,~Error:Data,~Out:Data,~declaration:Cmd.Program(~S,~L.columns(~S,components),~L.resources(~S,resources),~components,~resources,~route,~Ops),~body:Cmd.Body(~S,~components,~resources,~route,~Ops,~User,~Error,~Out),result:Compilation(~S,~components,~resources,~route,~Ops) & (W.World<S,L.columns(~S,components),L.resources(~S,resources),E> & (Owner(~S,~components,~resources,~E,~route,~Ops,~User,~Error,~Out,~declaration,~body) & Bool))) -> W.World<S,L.columns(~S,components),L.resources(~S,resources),E> & (Node(~S,~components,~resources,~E,~route,~Ops,~User,~Error,~Out,~declaration,~body) & Bool):
  match result:
    case (compilation,(world,(owner,pending))):(world,(Retained.pack(Compilation(~S,~components,~resources,~route,~Ops),Owner(~S,~components,~resources,~E,~route,~Ops,~User,~Error,~Out,~declaration,~body),compilation,owner),pending))
def pending_unpacked(~S:Data,~components:L.Layout,~resources:L.Layout,~E:Data,~route:L.Route,~Ops:Data -> (Type -> Type) -> Type -> Type -> Type,~User:Type,~Error:Data,~Out:Data,~declaration:Cmd.Program(~S,~L.columns(~S,components),~L.resources(~S,resources),~components,~resources,~route,~Ops),~body:Cmd.Body(~S,~components,~resources,~route,~Ops,~User,~Error,~Out),ids:List<&2,U32>,world:W.World<S,L.columns(~S,components),L.resources(~S,resources),E>,node:Compilation(~S,~components,~resources,~route,~Ops) & Owner(~S,~components,~resources,~E,~route,~Ops,~User,~Error,~Out,~declaration,~body)) -> W.World<S,L.columns(~S,components),L.resources(~S,resources),E> & (Node(~S,~components,~resources,~E,~route,~Ops,~User,~Error,~Out,~declaration,~body) & Bool):
  match node:
    case (compilation,owner):pending_returned(~S,~components,~resources,~E,~route,~Ops,~User,~Error,~Out,~declaration,~body,CommandAdmission.pending_with_compilation(~S,~L.columns(~S,components),~L.columns(~S,components),~L.resources(~S,resources),~E,~components,~resources,~route,~Ops,~User,~Error,~Out,~declaration,~body,~L.resources(~S,resources),compilation,ids,world,owner))
def pending(~S:Data,~components:L.Layout,~resources:L.Layout,~E:Data,~route:L.Route,~Ops:Data -> (Type -> Type) -> Type -> Type -> Type,~User:Type,~Error:Data,~Out:Data,~declaration:Cmd.Program(~S,~L.columns(~S,components),~L.resources(~S,resources),~components,~resources,~route,~Ops),~body:Cmd.Body(~S,~components,~resources,~route,~Ops,~User,~Error,~Out),ids:List<&2,U32>,world:W.World<S,L.columns(~S,components),L.resources(~S,resources),E>,node:Node(~S,~components,~resources,~E,~route,~Ops,~User,~Error,~Out,~declaration,~body)) -> W.World<S,L.columns(~S,components),L.resources(~S,resources),E> & (Node(~S,~components,~resources,~E,~route,~Ops,~User,~Error,~Out,~declaration,~body) & Bool):
  pending_unpacked(~S,~components,~resources,~E,~route,~Ops,~User,~Error,~Out,~declaration,~body,ids,world,Retained.unpack(Compilation(~S,~components,~resources,~route,~Ops),Owner(~S,~components,~resources,~E,~route,~Ops,~User,~Error,~Out,~declaration,~body),node))
