def Node(~S:Data,~components:L.Layout,~resources:L.Layout,~E:Data,~Ops:Data -> (Type -> Type) -> Type -> Type,~Local:Type,~Error:Data,~Out:Data,~declaration:Build.FrameworkProgram(~S,~L.columns(~S,components),~L.columns(~S,components),~L.resources(~S,resources),~Ops),~body:Sys.Body(~S,~Ops,~Local,~Error,~Out)) -> Type:
  Retained.CompiledBinding<D.Compilation<S,L.columns(~S,components),L.columns(~S,components),L.resources(~S,resources),Ops>,Sys.Owner<S,L.columns(~S,components),L.columns(~S,components),L.resources(~S,resources),E,Ops,Local,Error,Out,declaration,body>>
def define_with_compilation(~S:Data,~components:L.Layout,~resources:L.Layout,~E:Data,~Ops:Data -> (Type -> Type) -> Type -> Type,~Local:Type,~Error:Data,~Out:Data,~declaration:Build.FrameworkProgram(~S,~L.columns(~S,components),~L.columns(~S,components),~L.resources(~S,resources),~Ops),~body:Sys.Body(~S,~Ops,~Local,~Error,~Out),compilation:D.Compilation<S,L.columns(~S,components),L.columns(~S,components),L.resources(~S,resources),Ops>,world:W.World<S,L.columns(~S,components),L.resources(~S,resources),E>,name:String,local:Local) -> D.Compilation<S,L.columns(~S,components),L.columns(~S,components),L.resources(~S,resources),Ops> & Sys.Defined<W.World<S,L.columns(~S,components),L.resources(~S,resources),E>,Sys.Owner<S,L.columns(~S,components),L.columns(~S,components),L.resources(~S,resources),E,Ops,Local,Error,Out,declaration,body>,Local>:
  Registration.define_with_compilation(~S,~L.columns(~S,components),~L.columns(~S,components),~L.resources(~S,resources),~E,~Ops,~Local,~Error,~Out,~declaration,~body,~L.resources(~S,resources),compilation,world,name,local)
def run_returned(~S:Data,~components:L.Layout,~resources:L.Layout,~E:Data,~Ops:Data -> (Type -> Type) -> Type -> Type,~Local:Type,~Error:Data,~Out:Data,~declaration:Build.FrameworkProgram(~S,~L.columns(~S,components),~L.columns(~S,components),~L.resources(~S,resources),~Ops),~body:Sys.Body(~S,~Ops,~Local,~Error,~Out),result:D.Compilation<S,L.columns(~S,components),L.columns(~S,components),L.resources(~S,resources),Ops> & Sys.RunResult<W.World<S,L.columns(~S,components),L.resources(~S,resources),E>,Sys.Owner<S,L.columns(~S,components),L.columns(~S,components),L.resources(~S,resources),E,Ops,Local,Error,Out,declaration,body>,Error,Out>) -> Node(~S,~components,~resources,~E,~Ops,~Local,~Error,~Out,~declaration,~body) & (W.World<S,L.columns(~S,components),L.resources(~S,resources),E> & Exec.Invocation<Error,Out>):
  match result:
    case (compilation,Sys.Refused{world,system}):(Retained.pack(D.Compilation<S,L.columns(~S,components),L.columns(~S,components),L.resources(~S,resources),Ops>,Sys.Owner<S,L.columns(~S,components),L.columns(~S,components),L.resources(~S,resources),E,Ops,Local,Error,Out,declaration,body>,compilation,system),(world,Exec.AdmissionRefused{}))
    case (compilation,Sys.Executed{world,system,Sys.Success{output}}):(Retained.pack(D.Compilation<S,L.columns(~S,components),L.columns(~S,components),L.resources(~S,resources),Ops>,Sys.Owner<S,L.columns(~S,components),L.columns(~S,components),L.resources(~S,resources),E,Ops,Local,Error,Out,declaration,body>,compilation,system),(world,Exec.Completed{output}))
    case (compilation,Sys.Executed{world,system,Sys.BodyError{error,output}}):(Retained.pack(D.Compilation<S,L.columns(~S,components),L.columns(~S,components),L.resources(~S,resources),Ops>,Sys.Owner<S,L.columns(~S,components),L.columns(~S,components),L.resources(~S,resources),E,Ops,Local,Error,Out,declaration,body>,compilation,system),(world,Exec.BodyError{error,output}))
def run_inspected(~S:Data,~components:L.Layout,~resources:L.Layout,~E:Data,~Ops:Data -> (Type -> Type) -> Type -> Type,~Local:Type,~Error:Data,~Out:Data,~declaration:Build.FrameworkProgram(~S,~L.columns(~S,components),~L.columns(~S,components),~L.resources(~S,resources),~Ops),~body:Sys.Body(~S,~Ops,~Local,~Error,~Out),~construction:D.Compilation<S,L.columns(~S,components),L.columns(~S,components),L.resources(~S,resources),Ops>,owner:Sys.Owner<S,L.columns(~S,components),L.columns(~S,components),L.resources(~S,resources),E,Ops,Local,Error,Out,declaration,body>,inspected:Admission.Inspection<S,components,resources,L.columns(~S,components),L.resources(~S,resources),E,Ops,declaration>) -> Node(~S,~components,~resources,~E,~Ops,~Local,~Error,~Out,~declaration,~body) & (W.World<S,L.columns(~S,components),L.resources(~S,resources),E> & Exec.Invocation<Error,Out>):
  match inspected:
    case Admission.Refused{world,compilation}:(Retained.pack(D.Compilation<S,L.columns(~S,components),L.columns(~S,components),L.resources(~S,resources),Ops>,Sys.Owner<S,L.columns(~S,components),L.columns(~S,components),L.resources(~S,resources),E,Ops,Local,Error,Out,declaration,body>,compilation,owner),(world,Exec.AdmissionRefused{}))
    case Admission.Admitted{world,compilation,_}:run_returned(~S,~components,~resources,~E,~Ops,~Local,~Error,~Out,~declaration,~body,Sys.run_retained_compilation(~S,~L.columns(~S,components),~L.resources(~S,resources),~E,~Ops,~Local,~Error,~Out,~declaration,~body,~D.trusted_construction_caps(~S,~L.columns(~S,components),~L.columns(~S,components),~L.resources(~S,resources),~Ops,construction),compilation,owner,world))
def run(~S:Data,~components:L.Layout,~resources:L.Layout,~E:Data,~Ops:Data -> (Type -> Type) -> Type -> Type,~Local:Type,~Error:Data,~Out:Data,~declaration:Build.FrameworkProgram(~S,~L.columns(~S,components),~L.columns(~S,components),~L.resources(~S,resources),~Ops),~body:Sys.Body(~S,~Ops,~Local,~Error,~Out),~construction:D.Compilation<S,L.columns(~S,components),L.columns(~S,components),L.resources(~S,resources),Ops>,node:Node(~S,~components,~resources,~E,~Ops,~Local,~Error,~Out,~declaration,~body),world:W.World<S,L.columns(~S,components),L.resources(~S,resources),E>) -> Node(~S,~components,~resources,~E,~Ops,~Local,~Error,~Out,~declaration,~body) & (W.World<S,L.columns(~S,components),L.resources(~S,resources),E> & Exec.Invocation<Error,Out>):
  {\{Tuple: compilation => owner => run_inspected(~S,~components,~resources,~E,~Ops,~Local,~Error,~Out,~declaration,~body,~construction,owner,Admission.inspect_with_compilation(~S,~components,~resources,~L.columns(~S,components),~L.resources(~S,resources),~E,~Ops,~declaration,compilation,world))} : (D.Compilation<S,L.columns(~S,components),L.columns(~S,components),L.resources(~S,resources),Ops> & Sys.Owner<S,L.columns(~S,components),L.columns(~S,components),L.resources(~S,resources),E,Ops,Local,Error,Out,declaration,body>) -> Node(~S,~components,~resources,~E,~Ops,~Local,~Error,~Out,~declaration,~body) & (W.World<S,L.columns(~S,components),L.resources(~S,resources),E> & Exec.Invocation<Error,Out>)}(Retained.unpack(D.Compilation<S,L.columns(~S,components),L.columns(~S,components),L.resources(~S,resources),Ops>,Sys.Owner<S,L.columns(~S,components),L.columns(~S,components),L.resources(~S,resources),E,Ops,Local,Error,Out,declaration,body>,node))
def dispatch_selected(~S:Data,~components:L.Layout,~resources:L.Layout,~E:Data,~Ops:Data -> (Type -> Type) -> Type -> Type,~Local:Type,~Error:Data,~Out:Data,~declaration:Build.FrameworkProgram(~S,~L.columns(~S,components),~L.columns(~S,components),~L.resources(~S,resources),~Ops),~body:Sys.Body(~S,~Ops,~Local,~Error,~Out),~construction:D.Compilation<S,L.columns(~S,components),L.columns(~S,components),L.resources(~S,resources),Ops>,node:Node(~S,~components,~resources,~E,~Ops,~Local,~Error,~Out,~declaration,~body),world:W.World<S,L.columns(~S,components),L.resources(~S,resources),E>,selected:Bool) -> Node(~S,~components,~resources,~E,~Ops,~Local,~Error,~Out,~declaration,~body) & (W.World<S,L.columns(~S,components),L.resources(~S,resources),E> & Exec.Invocation<Error,Out>):
  match selected:
    case False{}:(node,(world,Exec.AdmissionRefused{}))
    case True{}:run(~S,~components,~resources,~E,~Ops,~Local,~Error,~Out,~declaration,~body,~construction,node,world)
def dispatch_unpacked(~S:Data,~components:L.Layout,~resources:L.Layout,~E:Data,~Ops:Data -> (Type -> Type) -> Type -> Type,~Local:Type,~Error:Data,~Out:Data,~declaration:Build.FrameworkProgram(~S,~L.columns(~S,components),~L.columns(~S,components),~L.resources(~S,resources),~Ops),~body:Sys.Body(~S,~Ops,~Local,~Error,~Out),~construction:D.Compilation<S,L.columns(~S,components),L.columns(~S,components),L.resources(~S,resources),Ops>,node:D.Compilation<S,L.columns(~S,components),L.columns(~S,components),L.resources(~S,resources),Ops> & Sys.Owner<S,L.columns(~S,components),L.columns(~S,components),L.resources(~S,resources),E,Ops,Local,Error,Out,declaration,body>,world:W.World<S,L.columns(~S,components),L.resources(~S,resources),E>,id:U32) -> Node(~S,~components,~resources,~E,~Ops,~Local,~Error,~Out,~declaration,~body) & (W.World<S,L.columns(~S,components),L.resources(~S,resources),E> & Exec.Invocation<Error,Out>):
  match node:
    case (compilation,Sys.Owner{namespace,+actual,name,access,cursor,local}):dispatch_selected(~S,~components,~resources,~E,~Ops,~Local,~Error,~Out,~declaration,~body,~construction,Retained.pack(D.Compilation<S,L.columns(~S,components),L.columns(~S,components),L.resources(~S,resources),Ops>,Sys.Owner<S,L.columns(~S,components),L.columns(~S,components),L.resources(~S,resources),E,Ops,Local,Error,Out,declaration,body>,compilation,Sys.Owner{namespace,actual,name,access,cursor,local}),world,U32.is_eq(actual,id))
def dispatch(~S:Data,~components:L.Layout,~resources:L.Layout,~E:Data,~Ops:Data -> (Type -> Type) -> Type -> Type,~Local:Type,~Error:Data,~Out:Data,~declaration:Build.FrameworkProgram(~S,~L.columns(~S,components),~L.columns(~S,components),~L.resources(~S,resources),~Ops),~body:Sys.Body(~S,~Ops,~Local,~Error,~Out),~construction:D.Compilation<S,L.columns(~S,components),L.columns(~S,components),L.resources(~S,resources),Ops>,node:Node(~S,~components,~resources,~E,~Ops,~Local,~Error,~Out,~declaration,~body),world:W.World<S,L.columns(~S,components),L.resources(~S,resources),E>,id:U32) -> Node(~S,~components,~resources,~E,~Ops,~Local,~Error,~Out,~declaration,~body) & (W.World<S,L.columns(~S,components),L.resources(~S,resources),E> & Exec.Invocation<Error,Out>):
