def facts_unpacked(~S:Data,~components:L.Layout,~resources:L.Layout,~E:Data,~Ops:Data -> (Type -> Type) -> Type -> Type,~Local:Type,~Error:Data,~Out:Data,~declaration:Build.FrameworkProgram(~S,~L.columns(~S,components),~L.columns(~S,components),~L.resources(~S,resources),~Ops),~body:Sys.Body(~S,~Ops,~Local,~Error,~Out),~construction:D.Compilation<S,L.columns(~S,components),L.columns(~S,components),L.resources(~S,resources),Ops>,node:D.Compilation<S,L.columns(~S,components),L.columns(~S,components),L.resources(~S,resources),Ops> & Sys.Owner<S,L.columns(~S,components),L.columns(~S,components),L.resources(~S,resources),E,Ops,Local,Error,Out,declaration,body>) -> Reg.Registry<W.World<S,L.columns(~S,components),L.resources(~S,resources),E>,Node(~S,~components,~resources,~E,~Ops,~Local,~Error,~Out,~declaration,~body),Error,Out,dispatch(~S,~components,~resources,~E,~Ops,~Local,~Error,~Out,~declaration,~body,~construction)>:
  match node:
    case (D.Supported{D.Declaration{caps,+requirements},recipes},Sys.Owner{namespace,+id,name,access,cursor,local}):Reg.Registry{Retained.pack(D.Compilation<S,L.columns(~S,components),L.columns(~S,components),L.resources(~S,resources),Ops>,Sys.Owner<S,L.columns(~S,components),L.columns(~S,components),L.resources(~S,resources),E,Ops,Local,Error,Out,declaration,body>,D.Supported{D.Declaration{caps,requirements},recipes},Sys.Owner{namespace,id,name,access,cursor,local}),[Plan.Node{id,D.qualified(requirements)}]}
    case (D.Unsupported{caps,+requirements,recipes},Sys.Owner{namespace,+id,name,access,cursor,local}):Reg.Registry{Retained.pack(D.Compilation<S,L.columns(~S,components),L.columns(~S,components),L.resources(~S,resources),Ops>,Sys.Owner<S,L.columns(~S,components),L.columns(~S,components),L.resources(~S,resources),E,Ops,Local,Error,Out,declaration,body>,D.Unsupported{caps,requirements,recipes},Sys.Owner{namespace,id,name,access,cursor,local}),[Plan.Node{id,D.qualified(requirements)}]}
