    case D.Unsupported{Permission.Prepared{+actualPermission,+actualRelations,actualSelection,actualOps},actualAccess,actualRecipes} Cmd.Owner{Sys.Owner{namespace,+id,name,access,cursor,local}}:(D.Unsupported{Permission.Prepared{actualPermission,actualRelations,actualSelection,actualOps},actualAccess,actualRecipes},Cmd.publication_gate(W.World<S,WC,WR,E>,Cmd.Owner<S,C,R,E,layout,resources,route,Ops,User,Error,Out,declaration,body>,Settings.member(id,ids),world,Cmd.Owner{Sys.Owner{namespace,id,name,access,cursor,local}},actionWorld => actionOwner => published(~S,~WC,~C,~R,~E,~layout,~resources,~route,~Ops,~User,~Error,~Out,~declaration,~body,~WR,~same,Cmd.publish_interpreted(~S,~C,~R,~E,~layout,~resources,~route,~valid,~Ops,~User,~Error,~Out,~declaration,~body,~WR,~sameWR,~relations,~selection,~scopeInterpreter,Cmd.UnsupportedPermission{actualPermission,actualRelations},tick,command_world(~S,~WC,~WR,~E,~layout,same,actionWorld),actionOwner))))

def pending_inspected(~S:Data,~WC:Type,~C:Type,~R:Type,~E:Data,~layout:Layout.Layout,~resources:Layout.Layout,~route:Layout.Route,~Ops:Data -> (Type -> Type) -> Type -> Type -> Type,~User:Type,~Error:Data,~Out:Data,~declaration:Cmd.Program(~S,~C,~R,~layout,~resources,~route,~Ops),~body:Cmd.Body(~S,~layout,~resources,~route,~Ops,~User,~Error,~Out),~WR:Type,ids:List<&2,U32>,world:W.World<S,WC,WR,E>,owner:Cmd.Owner<S,C,R,E,layout,resources,route,Ops,User,Error,Out,declaration,body>,observed:D.Compilation<S,Layout.columns(~S,layout),C,R,Cmd.ScopedOps(~S,~layout,~resources,~route,~Ops)> & Cmd.CheckedPermission<S,resources>) -> D.Compilation<S,Layout.columns(~S,layout),C,R,Cmd.ScopedOps(~S,~layout,~resources,~route,~Ops)> & (W.World<S,WC,WR,E> & (Cmd.Owner<S,C,R,E,layout,resources,route,Ops,User,Error,Out,declaration,body> & Bool)):
