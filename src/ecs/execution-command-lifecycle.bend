import Base
import ./world.bend as W
import ./execution-system.bend as Sys
import ./execution-declaration.bend as D
import ./execution-builder.bend as Build
import ./execution-system-lifecycle.bend as Life
import ./execution-system-registration.bend as Registration
import ./execution-command-system.bend as Cmd
import ./execution-composer-layout.bend as Layout

# A detached command owner retains the same closed Program and actual Local,
# including permission, pending raw payloads and removed-owner receipts.
# Permission validation precedes metadata mutation and preserves refused owners.
type Rebinding<-World:Type,-Owner:Type> is Type:
  Rebound{world:World,owner:Owner}
  RebindRefused{world:World,detached:Life.Detached<Owner>}
def retired(~S:Data,~C:Type,~R:Type,~E:Data,~layout:Layout.Layout,~resources:Layout.Layout,~route:Layout.Route,~Ops:Data -> (Type -> Type) -> Type -> Type -> Type,~User:Type,~Error:Data,~Out:Data,~declaration:Cmd.Program(~S,~C,~R,~layout,~resources,~route,~Ops),~body:Cmd.Body(~S,~layout,~resources,~route,~Ops,~User,~Error,~Out),~WR:Type,result:Life.Retirement<W.World<S,Layout.columns(~S,layout),WR,E>,Cmd.System(~S,~C,~R,~E,~layout,~resources,~route,~Ops,~User,~Error,~Out,~declaration,~body)>) -> Life.Retirement<W.World<S,Layout.columns(~S,layout),WR,E>,Cmd.Owner<S,C,R,E,layout,resources,route,Ops,User,Error,Out,declaration,body>>:
  match result:
    case Life.Retired{world,Life.Detached{system}}:Life.Retired{world,Life.Detached{Cmd.Owner{system}}}
    case Life.RetirementRefused{world,system}:Life.RetirementRefused{world,Cmd.Owner{system}}
def retire_checked(~S:Data,~C:Type,~R:Type,~E:Data,~layout:Layout.Layout,~resources:Layout.Layout,~route:Layout.Route,~Ops:Data -> (Type -> Type) -> Type -> Type -> Type,~User:Type,~Error:Data,~Out:Data,~declaration:Cmd.Program(~S,~C,~R,~layout,~resources,~route,~Ops),~body:Cmd.Body(~S,~layout,~resources,~route,~Ops,~User,~Error,~Out),~WR:Type,world:W.World<S,Layout.columns(~S,layout),WR,E>,result:Cmd.Owner<S,C,R,E,layout,resources,route,Ops,User,Error,Out,declaration,body> & Bool) -> Life.Retirement<W.World<S,Layout.columns(~S,layout),WR,E>,Cmd.Owner<S,C,R,E,layout,resources,route,Ops,User,Error,Out,declaration,body>>:
  match result:
    case (owner,False{}):Life.RetirementRefused{world,owner}
    case (Cmd.Owner{system},True{}):retired(~S,~C,~R,~E,~layout,~resources,~route,~Ops,~User,~Error,~Out,~declaration,~body,~WR,Life.retire(~S,~(Layout.columns(~S,layout)),~C,~R,~E,~Cmd.ScopedOps(~S,~layout,~resources,~route,~Ops),~Cmd.Captures(~S,~layout,~resources,~route,~User),~Error,~Out,~Cmd.program_for_buffer(~S,~C,~R,~layout,~resources,~route,~Ops,~declaration),~Cmd.runner(~S,~layout,~resources,~route,~Ops,~User,~Error,~Out,~body),~WR,~E,system,world))
def retire(~S:Data,~C:Type,~R:Type,~E:Data,~layout:Layout.Layout,~resources:Layout.Layout,~route:Layout.Route,~Ops:Data -> (Type -> Type) -> Type -> Type -> Type,~User:Type,~Error:Data,~Out:Data,~declaration:Cmd.Program(~S,~C,~R,~layout,~resources,~route,~Ops),~body:Cmd.Body(~S,~layout,~resources,~route,~Ops,~User,~Error,~Out),~WR:Type,owner:Cmd.Owner<S,C,R,E,layout,resources,route,Ops,User,Error,Out,declaration,body>,world:W.World<S,Layout.columns(~S,layout),WR,E>) -> Life.Retirement<W.World<S,Layout.columns(~S,layout),WR,E>,Cmd.Owner<S,C,R,E,layout,resources,route,Ops,User,Error,Out,declaration,body>>:
  retire_checked(~S,~C,~R,~E,~layout,~resources,~route,~Ops,~User,~Error,~Out,~declaration,~body,~WR,world,Cmd.permission_matches(~S,~C,~R,~E,~layout,~resources,~route,~Ops,~User,~Error,~Out,~declaration,~body,Cmd.declared_permission(~S,~C,~R,~layout,~resources,~route,~Ops,~declaration),owner))
def restored(~S:Data,~C:Type,~R:Type,~E:Data,~layout:Layout.Layout,~resources:Layout.Layout,~route:Layout.Route,~Ops:Data -> (Type -> Type) -> Type -> Type -> Type,~User:Type,~Error:Data,~Out:Data,~declaration:Cmd.Program(~S,~C,~R,~layout,~resources,~route,~Ops),~body:Cmd.Body(~S,~layout,~resources,~route,~Ops,~User,~Error,~Out),~WR:Type,result:Life.Restoration<W.World<S,Layout.columns(~S,layout),WR,E>,Cmd.System(~S,~C,~R,~E,~layout,~resources,~route,~Ops,~User,~Error,~Out,~declaration,~body)>) -> Life.Restoration<W.World<S,Layout.columns(~S,layout),WR,E>,Cmd.Owner<S,C,R,E,layout,resources,route,Ops,User,Error,Out,declaration,body>>:
  match result:
    case Life.Restored{world,system}:Life.Restored{world,Cmd.Owner{system}}
    case Life.RestorationRefused{world,Life.Detached{system}}:Life.RestorationRefused{world,Life.Detached{Cmd.Owner{system}}}


def rebound(~S:Data,~C:Type,~R:Type,~E:Data,~layout:Layout.Layout,~resources:Layout.Layout,~route:Layout.Route,~Ops:Data -> (Type -> Type) -> Type -> Type -> Type,~User:Type,~Error:Data,~Out:Data,~declaration:Cmd.Program(~S,~C,~R,~layout,~resources,~route,~Ops),~body:Cmd.Body(~S,~layout,~resources,~route,~Ops,~User,~Error,~Out),~WR:Type,meta:Registration.Meta<Cmd.System(~S,~C,~R,~E,~layout,~resources,~route,~Ops,~User,~Error,~Out,~declaration,~body)>,result:Sys.Defined<W.World<S,Layout.columns(~S,layout),WR,E>,Cmd.System(~S,~C,~R,~E,~layout,~resources,~route,~Ops,~User,~Error,~Out,~declaration,~body),Cmd.Captures(~S,~layout,~resources,~route,~User)>) -> Rebinding<W.World<S,Layout.columns(~S,layout),WR,E>,Cmd.Owner<S,C,R,E,layout,resources,route,Ops,User,Error,Out,declaration,body>>:
  match result:
    case Sys.Defined{world,system}:Rebound{world,Cmd.Owner{system}}
    case Sys.DefinitionRefused{world,local}:RebindRefused{world,Life.Detached{Cmd.Owner{Registration.restored(~S,~(Layout.columns(~S,layout)),~C,~R,~E,~Cmd.ScopedOps(~S,~layout,~resources,~route,~Ops),~Cmd.Captures(~S,~layout,~resources,~route,~User),~Error,~Out,~Cmd.program_for_buffer(~S,~C,~R,~layout,~resources,~route,~Ops,~declaration),~Cmd.runner(~S,~layout,~resources,~route,~Ops,~User,~Error,~Out,~body),meta,local)}}}



def restored_with_compilation_result(~S:Data,~C:Type,~R:Type,~E:Data,~layout:Layout.Layout,~resources:Layout.Layout,~route:Layout.Route,~Ops:Data -> (Type -> Type) -> Type -> Type -> Type,~User:Type,~Error:Data,~Out:Data,~declaration:Cmd.Program(~S,~C,~R,~layout,~resources,~route,~Ops),~body:Cmd.Body(~S,~layout,~resources,~route,~Ops,~User,~Error,~Out),~WR:Type,result:D.Compilation<S,Layout.columns(~S,layout),C,R,Cmd.ScopedOps(~S,~layout,~resources,~route,~Ops)> & Life.Restoration<W.World<S,Layout.columns(~S,layout),WR,E>,Cmd.System(~S,~C,~R,~E,~layout,~resources,~route,~Ops,~User,~Error,~Out,~declaration,~body)>) -> D.Compilation<S,Layout.columns(~S,layout),C,R,Cmd.ScopedOps(~S,~layout,~resources,~route,~Ops)> & Life.Restoration<W.World<S,Layout.columns(~S,layout),WR,E>,Cmd.Owner<S,C,R,E,layout,resources,route,Ops,User,Error,Out,declaration,body>>:
  match result:
    case (compilation,result):(compilation,restored(~S,~C,~R,~E,~layout,~resources,~route,~Ops,~User,~Error,~Out,~declaration,~body,~WR,result))

def restore_with_compilation_checked(~S:Data,~C:Type,~R:Type,~E:Data,~layout:Layout.Layout,~resources:Layout.Layout,~route:Layout.Route,~Ops:Data -> (Type -> Type) -> Type -> Type -> Type,~User:Type,~Error:Data,~Out:Data,~declaration:Cmd.Program(~S,~C,~R,~layout,~resources,~route,~Ops),~body:Cmd.Body(~S,~layout,~resources,~route,~Ops,~User,~Error,~Out),~WR:Type,compilation:D.Compilation<S,Layout.columns(~S,layout),C,R,Cmd.ScopedOps(~S,~layout,~resources,~route,~Ops)>,world:W.World<S,Layout.columns(~S,layout),WR,E>,result:Cmd.Owner<S,C,R,E,layout,resources,route,Ops,User,Error,Out,declaration,body> & Bool) -> D.Compilation<S,Layout.columns(~S,layout),C,R,Cmd.ScopedOps(~S,~layout,~resources,~route,~Ops)> & Life.Restoration<W.World<S,Layout.columns(~S,layout),WR,E>,Cmd.Owner<S,C,R,E,layout,resources,route,Ops,User,Error,Out,declaration,body>>:
  match result:
    case (owner,False{}):(compilation,Life.RestorationRefused{world,Life.Detached{owner}})
    case (Cmd.Owner{system},True{}):restored_with_compilation_result(~S,~C,~R,~E,~layout,~resources,~route,~Ops,~User,~Error,~Out,~declaration,~body,~WR,Life.restore_with_compilation(~S,~(Layout.columns(~S,layout)),~C,~R,~E,~Cmd.ScopedOps(~S,~layout,~resources,~route,~Ops),~Cmd.Captures(~S,~layout,~resources,~route,~User),~Error,~Out,~Cmd.program_for_buffer(~S,~C,~R,~layout,~resources,~route,~Ops,~declaration),~Cmd.runner(~S,~layout,~resources,~route,~Ops,~User,~Error,~Out,~body),~WR,~E,compilation,Life.Detached{system},world))
def restore_with_compilation(~S:Data,~C:Type,~R:Type,~E:Data,~layout:Layout.Layout,~resources:Layout.Layout,~route:Layout.Route,~Ops:Data -> (Type -> Type) -> Type -> Type -> Type,~User:Type,~Error:Data,~Out:Data,~declaration:Cmd.Program(~S,~C,~R,~layout,~resources,~route,~Ops),~body:Cmd.Body(~S,~layout,~resources,~route,~Ops,~User,~Error,~Out),~WR:Type,compilation:D.Compilation<S,Layout.columns(~S,layout),C,R,Cmd.ScopedOps(~S,~layout,~resources,~route,~Ops)>,detached:Life.Detached<Cmd.Owner<S,C,R,E,layout,resources,route,Ops,User,Error,Out,declaration,body>>,world:W.World<S,Layout.columns(~S,layout),WR,E>) -> D.Compilation<S,Layout.columns(~S,layout),C,R,Cmd.ScopedOps(~S,~layout,~resources,~route,~Ops)> & Life.Restoration<W.World<S,Layout.columns(~S,layout),WR,E>,Cmd.Owner<S,C,R,E,layout,resources,route,Ops,User,Error,Out,declaration,body>>:
